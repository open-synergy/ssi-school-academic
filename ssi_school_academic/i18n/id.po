#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_score_predicate_line.py:0
#, python-format
msgid ""
"\n"
"Context: Validate score predicate line\n"
"Database ID: %s\n"
"Problem: Minimum scores within a predicate table must be unique.\n"
"Solution: Change or remove the lines that share the same minimum score\n"
msgstr ""
"\n"
"Konteks: Validasi baris predikat nilai\n"
"ID Basis Data: %s\n"
"Masalah: KKM dalam satu tabel predikat harus unik.\n"
"Solusi: Ubah atau hapus baris yang memiliki KKM yang sama\n"

#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_subject_minimum_score.py:0
#, python-format
msgid ""
"\n"
"Context: Validate subject minimum score\n"
"Database ID: %s\n"
