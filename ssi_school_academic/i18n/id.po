#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_report_card.py:0
#, python-format
msgid ""
"\n"
"Context: Save report card\n"
"Database ID: %s\n"
"Problem: A report card already exists for this enrollment and report card "
"type.\n"
"Solution: Open the existing report card, or cancel it before creating a new "
"one\n"
msgstr ""
"\n"
"Konteks: Simpan raport\n"
"ID Basis Data: %s\n"
"Masalah: Raport sudah ada untuk pendaftaran dan jenis raport ini.\n"
"Solusi: Buka raport yang sudah ada, atau batalkan sebelum membuat yang baru\n"

#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_report_card.py:0
#, python-format
msgid ""
"\n"
"Context: Save report card\n"
"Database ID: %s\n"
"Problem: Absence days cannot be negative.\n"
"Solution: Enter 0 or a positive number of days\n"
msgstr ""
"\n"
"Konteks: Simpan raport\n"
"ID Basis Data: %s\n"
"Masalah: Jumlah hari ketidakhadiran tidak boleh negatif.\n"
"Solusi: Masukkan 0 atau jumlah hari yang positif\n"

#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_report_card_line.py:0
#, python-format
msgid ""
"\n"
"Context: Save report card line\n"
"Database ID: %s\n"
"Problem: Each subject may only appear once per report card.\n"
"Solution: Remove the duplicate line\n"
msgstr ""
"\n"
"Konteks: Simpan baris raport\n"
"ID Basis Data: %s\n"
"Masalah: Setiap mata pelajaran hanya boleh muncul satu kali per raport.\n"
