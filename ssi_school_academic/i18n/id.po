#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_score_predicate_line.py:0
#, python-format
msgid ""
"\n"
"Context: Validate score predicate line\n"
"Database ID: %s\n"
"Problem: Minimum score must be between 0 and 100.\n"
"Solution: Enter a minimum score from 0 to 100\n"
msgstr ""
"\n"
"Konteks: Validasi baris predikat nilai\n"
"ID Basis Data: %s\n"
"Masalah: KKM harus antara 0 dan 100.\n"
