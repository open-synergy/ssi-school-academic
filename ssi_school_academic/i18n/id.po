#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_report_card_type.py:0
#, python-format
msgid ""
"\n"
"Context: Validate report card type\n"
"Database ID: %s\n"
"Problem: A component may only be weighted once.\n"
"Solution: Keep each component either averaged or in one weight line\n"
msgstr ""
"\n"
"Konteks: Validasi jenis raport\n"
"ID Basis Data: %s\n"
"Masalah: Sebuah komponen hanya boleh diberi bobot satu kali.\n"
"Solusi: Biarkan setiap komponen dirata-rata atau berada dalam satu baris "
"bobot\n"

#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_report_card_type.py:0
#, python-format
msgid ""
"\n"
"Context: Validate report card type\n"
"Database ID: %s\n"
"Problem: Averaged components are required when the average weight is set.\n"
"Solution: Select the averaged components or set the average weight to 0\n"
msgstr ""
"\n"
"Konteks: Validasi jenis raport\n"
"ID Basis Data: %s\n"
"Masalah: Komponen yang dirata-rata wajib diisi bila bobot rata-rata "
"ditetapkan.\n"
"Solusi: Pilih komponen yang dirata-rata atau atur bobot rata-rata menjadi 0\n"

#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_report_card_type.py:0
#, python-format
msgid ""
"\n"
"Context: Validate report card type\n"
"Database ID: %s\n"
"Problem: Rounding threshold must be between 0 and 1.\n"
"Solution: Enter a rounding threshold above 0 and below 1\n"
msgstr ""
"\n"
"Konteks: Validasi jenis raport\n"
"ID Basis Data: %s\n"
"Masalah: Ambang pembulatan harus antara 0 dan 1.\n"
"Solusi: Masukkan ambang pembulatan di atas 0 dan di bawah 1\n"

#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_report_card_type.py:0
#, python-format
msgid ""
"\n"
"Context: Validate report card type\n"
"Database ID: %s\n"
"Problem: Total weight must be 100%%.\n"
"Solution: Adjust the average weight and the component weights to total "
"100%%\n"
msgstr ""
"\n"
"Konteks: Validasi jenis raport\n"
"ID Basis Data: %s\n"
"Masalah: Total bobot harus 100%%.\n"
"Solusi: Sesuaikan bobot rata-rata dan bobot komponen agar totalnya 100%%\n"

#. module: ssi_school_academic
#: code:addons/ssi_school_academic/models/school_score_predicate.py:0
#, python-format
msgid ""
"\n"
"Context: Validate score predicate\n"
"Database ID: %s\n"
"Problem: A grade may only belong to one active predicate table.\n"
"Solution: Remove the grade from the other active predicate table or archive "
"it\n"
msgstr ""
"\n"
"Konteks: Validasi predikat nilai\n"
"ID Basis Data: %s\n"
