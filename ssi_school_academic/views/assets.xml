<odoo>
    <template
        id="assets_backend"
        name="ssi_school_academic assets backend"
        inherit_id="web.assets_backend"
    >
        <xpath expr="." position="inside">
            <link
                rel="stylesheet"
                type="text/scss"
                href="/ssi_school_academic/static/src/scss/school_report_card.scss"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/src/js/score_entry_widget.js"
            />
            <link
                rel="stylesheet"
                type="text/scss"
                href="/ssi_school_academic/static/src/scss/school_score_grid.scss"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/src/js/score_grid_renderer.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/src/js/score_grid_widget.js"
            />
        </xpath>
    </template>

    <template
        id="assets_tests"
        name="ssi_school_academic assets tests"
        inherit_id="web.assets_tests"
    >
        <xpath expr="." position="inside">
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_subject_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_score_component_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_subject_outcome_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_report_card_main_subject_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_report_card_type_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_score_predicate_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_score_sheet_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_score_sheet_enter_scores_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_report_card_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/print_report_card_ledger_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_teaching_assignment_tour.js"
            />
            <script
                type="text/javascript"
                src="/ssi_school_academic/static/tests/tours/school_curriculum_tour.js"
            />
        </xpath>
    </template>
</odoo>
