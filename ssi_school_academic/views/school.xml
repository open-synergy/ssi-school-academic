<odoo>
<record id="school_view_form" model="ir.ui.view">
    <field name="name">school - form (academic)</field>
    <field name="model">school</field>
    <field name="inherit_id" ref="ssi_school.school_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='branch_id']" position="after">
                <field name="teacher_mandatory_weekly_hours" />
                <field name="co_teaching_hour_factor" />
            </xpath>
        </data>
    </field>
</record>
</odoo>
