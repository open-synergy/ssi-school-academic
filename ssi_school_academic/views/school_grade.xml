<odoo>
<record id="school_grade_view_form" model="ir.ui.view">
    <field name="name">school_grade - form (academic)</field>
    <field name="model">school_grade</field>
    <field name="inherit_id" ref="ssi_school.school_grade_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='next_grade_id']" position="after">
                <field name="phase" />
            </xpath>
        </data>
    </field>
</record>
</odoo>
