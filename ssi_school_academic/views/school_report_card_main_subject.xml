<odoo>
<record id="school_report_card_main_subject_view_search" model="ir.ui.view">
    <field name="name">school_report_card_main_subject - search</field>
    <field name="model">school_report_card_main_subject</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="grade_id" />
                <field name="expertise_program" />
                <field name="subject_ids" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_grade"
                            string="Grade"
                            context="{'group_by': 'grade_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_report_card_main_subject_view_tree" model="ir.ui.view">
    <field name="name">school_report_card_main_subject - tree</field>
    <field name="model">school_report_card_main_subject</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="grade_id" />
                <field name="expertise_program" />
                <field name="subject_ids" widget="many2many_tags" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_report_card_main_subject_view_form" model="ir.ui.view">
    <field name="name">school_report_card_main_subject - form</field>
    <field name="model">school_report_card_main_subject</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="grade_id" />
                <field name="expertise_program" />
                <field name="subject_ids" widget="many2many_tags" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_report_card_main_subject_action" model="ir.actions.act_window">
    <field name="name">Main Subjects</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_report_card_main_subject</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_report_card_main_subject_menu"
        name="Main Subjects"
        parent="ssi_school.menu_subject_configuration"
        action="school_report_card_main_subject_action"
        groups="school_report_card_main_subject_group"
        sequence="50"
    />

</odoo>
