<odoo>
<record id="school_score_component_view_search" model="ir.ui.view">
    <field name="name">school_score_component - search</field>
    <field name="model">school_score_component</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="category" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_category"
                            string="Category"
                            context="{'group_by': 'category'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_score_component_view_tree" model="ir.ui.view">
    <field name="name">school_score_component - tree</field>
    <field name="model">school_score_component</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='name']" position="after">
                <field name="category" />
                <field name="sequence" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_score_component_view_form" model="ir.ui.view">
    <field name="name">school_score_component - form</field>
    <field name="model">school_score_component</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="category" />
                <field name="sequence" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_score_component_action" model="ir.actions.act_window">
    <field name="name">Score Components</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_score_component</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_score_component_menu"
        name="Score Components"
        parent="ssi_school.menu_subject_configuration"
        action="school_score_component_action"
        groups="school_score_component_group"
        sequence="20"
    />

</odoo>
