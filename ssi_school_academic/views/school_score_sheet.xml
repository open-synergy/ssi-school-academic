<odoo>
<record id="school_score_sheet_view_search" model="ir.ui.view">
    <field name="name">school_score_sheet - search</field>
    <field name="model">school_score_sheet</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="academic_term_id" />
                <field name="grade_class_id" />
                <field name="subject_id" />
                <field name="teacher_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_academic_term_id"
                            string="Academic Term"
                            context="{'group_by': 'academic_term_id'}"
                        />
                    <filter
                            name="group_by_grade_class_id"
                            string="Grade Class"
                            context="{'group_by': 'grade_class_id'}"
                        />
                    <filter
                            name="group_by_subject_id"
                            string="Subject"
                            context="{'group_by': 'subject_id'}"
                        />
                    <filter
                            name="group_by_teacher_id"
                            string="Teacher"
                            context="{'group_by': 'teacher_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_score_sheet_view_tree" model="ir.ui.view">
    <field name="name">school_score_sheet - tree</field>
    <field name="model">school_score_sheet</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="academic_term_id" />
                <field name="grade_class_id" />
                <field name="subject_id" />
                <field name="teacher_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_score_sheet_view_form" model="ir.ui.view">
    <field name="name">school_score_sheet - form</field>
    <field name="model">school_score_sheet</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="grade_class_id" />
                <field name="grade_id" />
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                        name="action_generate_lines"
                        type="object"
                        string="Generate Lines"
                        class="oe_highlight"
                        confirm="This replaces every line with one line per open enrollment and per score component. Continue?"
                        attrs="{'invisible':[('generate_lines_ok','=',False)]}"
                    />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="academic_term_id" />
                <field name="academic_year_id" />
                <field name="subject_id" />
                <field name="teacher_id" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="score" string="Scores">
                    <field name="minimum_score" invisible="1" />
                    <field name="line_ids" colspan="4" nolabel="1" widget="score_grid">
                        <tree editable="bottom">
                            <field
                                    name="enrollment_id"
                                    domain="[('state', '=', 'open'), ('grade_class_id', '=', parent.grade_class_id), ('academic_term_id', '=', parent.academic_term_id)]"
                                />
                            <field name="student_id" />
                            <field name="component_id" />
                            <field name="score" widget="score_entry" />
                            <field name="is_scored" invisible="1" />
                        </tree>
                        <form>
                            <group col="2">
                                <field
                                        name="enrollment_id"
                                        domain="[('state', '=', 'open'), ('grade_class_id', '=', parent.grade_class_id), ('academic_term_id', '=', parent.academic_term_id)]"
                                    />
                                <field name="student_id" />
                                <field name="component_id" />
                                <field name="score" widget="score_entry" />
                                <field name="is_scored" invisible="1" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='score']" position="after">
                <page name="objective" string="Learning Objectives">
                    <field name="component_ids" colspan="4" nolabel="1">
                        <tree editable="bottom" create="0">
                            <field name="component_id" />
                            <field
                                    name="objective_ids"
                                    widget="many2many_tags"
                                    domain="[('subject_id', '=', parent.subject_id), ('grade_id', '=', parent.grade_id), ('academic_term_id', '=', parent.academic_term_id)]"
                                />
                        </tree>
                        <form>
                            <group col="2">
                                <field name="component_id" />
                                <field
                                        name="objective_ids"
                                        widget="many2many_tags"
                                        domain="[('subject_id', '=', parent.subject_id), ('grade_id', '=', parent.grade_id), ('academic_term_id', '=', parent.academic_term_id)]"
                                    />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
            <xpath expr="//group[@name='policy_2']" position="inside">
                <field name="generate_lines_ok" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_score_sheet_action" model="ir.actions.act_window">
    <field name="name">School Score Sheets</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_score_sheet</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_score_sheet_menu"
        name="Score Sheets"
        parent="ssi_school.menu_school_classroom"
        action="school_score_sheet_action"
        groups="school_score_sheet_viewer_group"
        sequence="50"
    />
</odoo>
