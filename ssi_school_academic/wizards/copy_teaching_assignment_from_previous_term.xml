<odoo>
<record id="copy_teaching_assignment_from_previous_term_view_form" model="ir.ui.view">
    <field name="name">copy_teaching_assignment_from_previous_term - form</field>
    <field name="model">copy_teaching_assignment_from_previous_term</field>
    <field name="arch" type="xml">
        <form>
            <group name="group_1" colspan="4" col="2">
                <field name="source_term_id" />
                <field name="target_term_id" />
                <field name="assignment_ids" widget="many2many_tags" />
                <field
                        name="result_note"
                        attrs="{'invisible': [('result_note', '=', False)]}"
                    />
            </group>
            <footer>
                <button
                        name="action_copy"
                        type="object"
                        string="Copy"
                        class="btn-primary"
                        attrs="{'invisible': [('result_note', '!=', False)]}"
                    />
                <button string="Close" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>
</odoo>
