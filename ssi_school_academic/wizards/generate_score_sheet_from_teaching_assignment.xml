<odoo>
<record id="generate_score_sheet_from_teaching_assignment_view_form" model="ir.ui.view">
    <field name="name">generate_score_sheet_from_teaching_assignment - form</field>
    <field name="model">generate_score_sheet_from_teaching_assignment</field>
    <field name="arch" type="xml">
        <form>
            <group name="group_1" colspan="4" col="2">
                <field name="assignment_ids" widget="many2many_tags" />
                <field
                        name="result_note"
                        attrs="{'invisible': [('result_note', '=', False)]}"
                    />
            </group>
            <footer>
                <button
                        name="action_generate"
                        type="object"
                        string="Generate"
                        class="btn-primary"
                        attrs="{'invisible': [('result_note', '!=', False)]}"
                    />
                <button string="Close" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>

<record
        id="generate_score_sheet_from_teaching_assignment_action"
        model="ir.actions.act_window"
    >
    <field name="name">Generate Score Sheets</field>
    <field name="res_model">generate_score_sheet_from_teaching_assignment</field>
    <field name="view_mode">form</field>
    <field
            name="view_id"
            ref="generate_score_sheet_from_teaching_assignment_view_form"
        />
    <field name="target">new</field>
    <field name="binding_model_id" ref="model_school_teaching_assignment" />
    <field name="binding_view_types">list,form</field>
    <field name="groups_id" eval="[(4, ref('school_teaching_assignment_group'))]" />
</record>
</odoo>
