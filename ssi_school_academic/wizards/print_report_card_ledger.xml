<odoo>
<record id="print_report_card_ledger_view_form" model="ir.ui.view">
    <field name="name">print_report_card_ledger - form</field>
    <field name="model">print_report_card_ledger</field>
    <field name="arch" type="xml">
        <form>
            <group name="group_1" colspan="4" col="2">
                <field name="grade_class_id" />
                <field name="academic_term_id" />
                <field name="type_id" />
            </group>
            <footer>
                <button
                        name="action_show"
                        type="object"
                        string="Show"
                        class="btn-primary"
                    />
                <button
                        name="action_print"
                        type="object"
                        string="Print"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>
</odoo>
